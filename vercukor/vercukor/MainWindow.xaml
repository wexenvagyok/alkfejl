<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="vercukor.MainWindow"
        Title="Vércukor mérés"
        Height="1080"
        Width="1920"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Rectangle Fill="#FF3AD6FF" Height="180" VerticalAlignment="Top"/>
        <TextBlock Text="Vércukorszint mérés" FontSize="40" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,40,0,0" VerticalAlignment="Top"/>
        <Label Content="Nap sorszáma (1-30):" FontSize="24" Margin="150,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="napsorszam" Width="250" Height="40" FontSize="22" Margin="500,250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="Napszak:" FontSize="24" Margin="150,350,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="napszak" Width="250" Height="40" FontSize="22" Margin="500,350,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ComboBoxItem Content="Reggel"/>
            <ComboBoxItem Content="Délben"/>
            <ComboBoxItem Content="Este"/>
        </ComboBox>
        <Label Content="Étkezés:" FontSize="24" Margin="150,450,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ComboBox x:Name="elottvagyutan" Width="250" Height="40" FontSize="22" Margin="500,450,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ComboBoxItem Content="Étkezés előtt két órűval"/>
            <ComboBoxItem Content="Étkezés után két órával"/>
        </ComboBox>
        <Label Content="Mért érték:" FontSize="24" Margin="150,550,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="mertErtek" Width="250" Height="40" FontSize="22" Margin="500,550,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button Content="Ellenőrzés" Width="250" Height="60" FontSize="24" FontWeight="Bold" Background="#FF3AD6FF" Foreground="White" Margin="500,680,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button_Click"/>
        <TextBlock x:Name="visszajelzes" FontSize="30" FontWeight="Bold" Foreground="DarkBlue" Margin="908,249,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="831" RenderTransformOrigin="0.654,0.59"/>
        <Button Content="Mentés" Width="250" Height="60" FontSize="24" FontWeight="Bold" Background="#FF31C34E" Foreground="White" Margin="500,756,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="Betöltés" Width="250" Height="60" FontSize="24" FontWeight="Bold" Background="#FFECB521" Foreground="White" Margin="500,834,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Button_Click"/>
        <TextBlock x:Name="magasVagyAlacsony" FontSize="30" FontWeight="Bold" Foreground="DarkBlue" Margin="770,552,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="342" RenderTransformOrigin="0.654,0.59"/>

    </Grid>
</Window>